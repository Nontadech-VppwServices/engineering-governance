{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-governance.local/schemas/ai-sdlc-mcp-scope.schema.json",
  "title": "AI SDLC MCP Execution Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "jira_issue_key",
    "execution_phase",
    "allowed_repositories",
    "working_branches",
    "permissions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "jira_issue_key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+-[0-9]+$" },
    "execution_phase": { "enum": ["analyze", "plan", "implement"] },
    "allowed_repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
    },
    "working_branches": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["can_modify_code", "can_create_pr", "can_merge", "can_deploy_production", "can_access_production_credentials"],
      "properties": {
        "can_modify_code": { "type": "boolean" },
        "can_create_pr": { "type": "boolean" },
        "can_merge": { "const": false },
        "can_deploy_production": { "const": false },
        "can_access_production_credentials": { "const": false }
      }
    },
    "effective_context_ref": { "type": ["string", "null"] }
  }
}
