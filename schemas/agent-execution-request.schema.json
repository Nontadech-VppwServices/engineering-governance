{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vespiario.internal/schemas/agent-execution-request.schema.json",
  "title": "Agent Execution Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "jira_issue_key", "work_type", "repository", "base_branch", "working_branch", "effective_context", "constraints"],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "jira_issue_key": { "type": "string" },
    "work_type": { "const": "task" },
    "execution_phase": {
      "enum": ["analyze", "plan", "implement"],
      "description": "Hermes execution phase. Omission is accepted for backward compatibility and is interpreted as implement by the trusted runner."
    },
    "objective": { "type": ["string", "null"], "maxLength": 8000 },
    "repository": { "type": "string" },
    "base_branch": { "type": "string" },
    "working_branch": { "type": "string" },
    "effective_context": { "type": "object" },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_merge", "allow_production_deploy", "allow_production_credentials"],
      "properties": {
        "allow_merge": { "const": false },
        "allow_production_deploy": { "const": false },
        "allow_production_credentials": { "const": false }
      }
    }
  }
}
