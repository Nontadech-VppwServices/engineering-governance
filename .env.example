# Copy to .env. Development defaults below are intentionally non-production.
COMPOSE_PROJECT_NAME=engineering-governance
POSTGRES_DB=engineering_governance
POSTGRES_USER=governance
POSTGRES_PASSWORD=local-dev-only-change-me

PHASE5_PORT=8085
PHASE5_API_TOKEN=local-phase5-token-change-me
PHASE6_PORT=8086
PHASE6_API_TOKEN=local-phase6-token-change-me

# Pin a digest or immutable version before production use.
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_GATEWAY_PORT=8642
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD=1
HERMES_UID=10000
HERMES_GID=10000

# Configure at least one model provider before starting the hermes profile.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
