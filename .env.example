# Copy to .env, chmod 600 .env, and replace every change-me value.
COMPOSE_PROJECT_NAME=engineering-governance
PUBLIC_DOMAIN=ai-sdlc.example.com
ACME_EMAIL=platform@example.com

POSTGRES_DB=engineering_governance
POSTGRES_USER=governance
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

CONTEXT_RESOLVER_API_TOKEN=change-me-context-resolver-token
PHASE4_API_TOKEN=change-me-phase4-token
PHASE5_API_TOKEN=change-me-phase5-token
PHASE6_API_TOKEN=change-me-phase6-token
WORKFLOW_CONTROL_API_TOKEN=change-me-workflow-control-token
WORKFLOW_CONTROL_GATEWAY_TOKEN=change-me-gateway-token
PRINCIPAL_SIGNING_SECRET=change-me-long-random-principal-secret
ACTOR_SIGNING_SECRET=change-me-long-random-actor-secret
AGENT_RUNNER_API_TOKEN=change-me-agent-runner-token
REPORTING_API_TOKEN=change-me-reporting-token
HERMES_DELIVERY_TOKEN=change-me-delivery-token

JIRA_BASE_URL=https://example.atlassian.net
JIRA_EMAIL=automation@example.com
JIRA_API_TOKEN=change-me-jira-token
JIRA_POLL_INTERVAL_MS=900000
JIRA_AI_PRIMARY_ASSIGNEE_ACCOUNT_ID=change-me-jira-account-id
JIRA_AI_ASSIGNEE_ACCOUNT_IDS=change-me-jira-account-id
JIRA_ALLOWED_PROJECT_KEYS=PIM,RPA,TMS,VESPISTI
JIRA_COMPONENT_FIELD_ID=
JIRA_WORK_TYPE_FIELD_ID=customfield_10000
JIRA_MODULE_NAME_FIELD_ID=customfield_10001
JIRA_TARGET_PATH_FIELD_ID=customfield_10002
JIRA_PROJECT_ID_FIELD_ID=customfield_10003
JIRA_DOMAIN_FIELD_ID=customfield_10004
JIRA_PROJECT_TYPE_FIELD_ID=customfield_10005
JIRA_DEPLOYMENT_TYPE_FIELD_ID=customfield_10006
JIRA_REPOSITORY_FIELD_ID=customfield_10007
JIRA_STATUS_MAPPINGS_JSON={}

GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=change-me-github-app-installation-token

HERMES_IMAGE=nousresearch/hermes-agent@sha256:071a7e5e6787156d1469ad04088cdbc0ce3db25d2727cb5a4e3958e3c57aa8f7
HERMES_CHAT_API_KEY=change-me-hermes-chat-key
HERMES_CODER_API_KEY=change-me-hermes-coder-key
AGENT_MODE=hermes
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

LINE_CHANNEL_ACCESS_TOKEN=change-me-line-access-token
LINE_CHANNEL_SECRET=change-me-line-channel-secret
LINE_ALLOWED_USERS=U00000000000000000000000000000000
LINE_ALLOWED_GROUPS=C00000000000000000000000000000000
LINE_HOME_CHANNEL=C00000000000000000000000000000000
LINE_ALERT_TARGET_ID=C00000000000000000000000000000000
LINE_DELIVERY_TARGET_IDS=U00000000000000000000000000000000,C00000000000000000000000000000000
LINE_IDENTITIES_JSON=[{"line_user_id":"U00000000000000000000000000000000","jira_account_id":"change-me-jira-account-id","github_login":"change-me-github-login","roles":["admin"]}]

REPORT_TIMEZONE=Asia/Bangkok
REPORT_DAILY_TIME=09:00
REPORT_WEEKLY_DAY=1
REPORT_WEEKLY_TIME=09:05
REPORT_MONTHLY_DAY=1
REPORT_MONTHLY_TIME=09:10
REPORT_MAX_ATTEMPTS=8
