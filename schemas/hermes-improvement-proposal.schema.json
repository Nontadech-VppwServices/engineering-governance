{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vespiario.internal/schemas/hermes-improvement-proposal.schema.json",
  "title": "Hermes Skill Improvement Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "kind", "risk", "skill", "observation_ids", "state", "evaluations", "approvals", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "proposal_id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["skill_create", "skill_update", "skill_retire"] },
    "risk": { "enum": ["low", "medium", "high"] },
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description", "version", "content"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "observation_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "state": { "enum": ["PROPOSED", "EVALUATING", "WAITING_HUMAN_APPROVAL", "APPROVED", "REJECTED", "PUBLISHED"] },
    "evaluations": { "type": "array", "items": { "type": "object" } },
    "approvals": { "type": "array", "items": { "type": "object" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "published_path": { "type": ["string", "null"] }
  }
}
