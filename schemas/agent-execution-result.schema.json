{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vespiario.internal/schemas/agent-execution-result.schema.json",
  "title": "Agent Execution Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "repository", "status", "changed_files", "quality_gates"],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string" },
    "repository": { "type": "string" },
    "execution_phase": { "enum": ["analyze", "plan", "implement"] },
    "hermes_run_id": { "type": ["string", "null"] },
    "artifact_content": { "type": ["string", "null"], "maxLength": 100000 },
    "status": { "enum": ["completed", "blocked", "failed", "analysis_only"] },
    "summary": { "type": ["string", "null"] },
    "commit_sha": { "type": ["string", "null"] },
    "changed_files": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "required", "status"],
        "properties": {
          "key": { "type": "string" },
          "required": { "type": "boolean" },
          "status": { "enum": ["passed", "failed", "not_run", "not_applicable"] },
          "details": { "type": ["string", "null"] }
        }
      }
    },
    "blocking_reason": { "type": ["string", "null"] }
  }
}
