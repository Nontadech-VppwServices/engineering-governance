{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-governance.local/schemas/bdr.schema.json",
  "title": "Business Decision Record Metadata",
  "type": "object",
  "required": ["id", "title", "status", "scope", "date", "decision_makers"],
  "properties": {
    "id": { "type": "string", "pattern": "^BDR-[A-Z0-9_-]+-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 3 },
    "status": { "enum": ["draft", "proposed", "accepted", "rejected", "superseded", "deprecated"] },
    "scope": { "enum": ["global", "domain", "project"] },
    "domain": { "type": ["string", "null"] },
    "project": { "type": ["string", "null"] },
    "date": { "type": "string", "format": "date" },
    "decision_makers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "related_adr": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_jira": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
