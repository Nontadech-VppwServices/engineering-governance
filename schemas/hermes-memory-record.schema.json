{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vespiario.internal/schemas/hermes-memory-record.schema.json",
  "title": "Hermes Memory Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "memory_id", "scope", "kind", "content", "source_refs", "classification", "authoritative", "status", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "memory_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["fact", "preference", "lesson", "summary"] },
    "content": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "source_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_type", "locator", "captured_at"],
        "properties": {
          "source_type": { "enum": ["jira", "repository", "adr", "bdr", "policy", "runtime", "session", "human"] },
          "locator": { "type": "string", "minLength": 1 },
          "captured_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "classification": { "enum": ["public", "internal", "confidential"] },
    "authoritative": { "const": false },
    "status": { "enum": ["active", "superseded", "revoked", "expired"] },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "supersedes": { "type": ["string", "null"] }
  }
}
